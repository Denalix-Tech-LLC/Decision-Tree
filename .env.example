# Copy to .env and fill in. .env is gitignored; never commit a real one.
#
# The only setting the tool needs. Any Postgres works — Neon, Supabase,
# Vercel Postgres, RDS, or a local server. Use the POOLED host if the provider
# offers one: serverless functions open a connection per instance.
#
# Neon:      postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Supabase:  postgres://postgres.xxx:pass@aws-0-region.pooler.supabase.com:6543/postgres
#            (Transaction pooler, port 6543. NOT db.xxx.supabase.co, which is
#             IPv6-only and unpooled, and which Vercel generally cannot reach.
#             The pooler user is postgres.<project-ref>, not plain postgres.)
#
# Check a candidate before deploying it:  npm run db:check -- "<url>"
# Local:     postgres://postgres:postgres@localhost:5432/tas
DATABASE_URL=

# Optional. TLS certificate verification is off by default, because managed
# Postgres is usually signed by a chain Node does not carry. Set this to
# verify-full once you have the provider's CA in the trust store.
# PGSSLMODE=verify-full

# Optional. Force TLS off — only for a local server that does not speak it.
# PGSSL=off

# Optional. Send session cookies without the Secure flag, so they work over
# plain http on localhost. dev-server.mjs sets this for you; never set it on a
# deployment that is reachable over the network.
# TAS_INSECURE_COOKIES=1

# ---- Sign in with Google (optional) ----------------------------------------
# Leave both blank and the Google button is not offered; email and password
# still work. Set both and the button appears by itself.
#
# Make an OAuth 2.0 Client ID of type "Web application" at
# https://console.cloud.google.com/apis/credentials, and register the callback
# under "Authorised redirect URIs" — one line per deployment:
#
#   https://your-project.vercel.app/api/auth/google/callback
#   http://localhost:8777/api/auth/google/callback
#
# The consent screen needs no scopes beyond openid, email and profile, which
# is all this tool asks for: who is signing in, and nothing else.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. The callback URL is worked out from the incoming request, which is
# right for Vercel and for localhost. Set this when the public URL is not the
# one the function sees — behind a proxy, or on a domain in front of Vercel.
# GOOGLE_REDIRECT_URI=https://tas.example.org/api/auth/google/callback

# ---- Who may edit the tree (optional) --------------------------------------
# The one account allowed into /admin. Set it and the editor belongs to that
# person: anyone else signed in is told so plainly, and a visitor who is not
# signed in is asked to. Leave it blank and the editor stays open to anyone
# who reaches the page, which is how this tool worked before accounts existed
# and how a deployment with no database has to keep working.
#
# Use the address the person actually signs in with — the same one on their
# Google account, if that is how they sign in. A comma-separated list is
# accepted for a handover week, but one address is the intent.
#
# Be clear about what this does: /admin is a page the browser fetches like any
# other, so this decides whether the editor is PRESENTED, not whether the file
# can be read. If the editor must be genuinely unreachable, put Vercel
# Deployment Protection on the project or drop admin.html from the deploy via
# .vercelignore — see the README.
ADMIN_EMAIL=
